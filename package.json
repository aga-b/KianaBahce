{
  "name": "kiana-bahce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @kiana/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.mjs && pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "check:plan": "python3 scripts/check-plan.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.57.0",
    "@types/node": "24.10.1",
    "eslint": "10.11.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
